{
  "name": "node-observability-lite",
  "version": "0.2.1",
  "description": "One-line lightweight observability for Node.js: actuator endpoints, request timelines, and event-loop watchdog without OpenTelemetry",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "lint": "sh -c 'for f in index.js src/*.js test/run.js; do node --check \"$f\"; done'",
    "typecheck": "npm run lint",
    "build": "npm pack --dry-run",
    "test": "node test/run.js",
    "test:coverage": "c8 --reporter=text --reporter=html node test/run.js",
    "test:coverage:check": "c8 --check-coverage --lines 90 --functions 90 --branches 90 --statements 90 --reporter=text node test/run.js",
    "smoke:express": "node scripts/smoke.js express 3000",
    "smoke:fastify": "node scripts/smoke.js fastify 3001",
    "smoke:koa": "node scripts/smoke.js koa 3002",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage:check"
  },
  "keywords": [
    "observability",
    "actuator",
    "watchdog",
    "tracing",
    "monitoring",
    "metrics",
    "prometheus",
    "express",
    "fastify",
    "koa",
    "ecosystem",
    "lightweight"
  ],
  "author": "beingmartinbmc",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "node-actuator-lite": "^3.2.0",
    "node-eventloop-watchdog": "^1.1.0",
    "node-request-trace": "^2.2.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "koa": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "c8": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingmartinbmc/node-observability-lite.git"
  },
  "bugs": {
    "url": "https://github.com/beingmartinbmc/node-observability-lite/issues"
  },
  "homepage": "https://github.com/beingmartinbmc/node-observability-lite#readme"
}
